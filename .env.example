# LLM API key (OpenAI or compatible provider)
LLM_API_KEY=your-api-key-here

# API endpoint (change to use a proxy like AITUNNEL or OpenRouter)
# Default: https://api.openai.com/v1 (official OpenAI)
# AITUNNEL (Russia, no VPN): https://api.aitunnel.ru/v1/
# OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=https://api.openai.com/v1

# Model name (must support function calling)
LLM_MODEL=gpt-4o-mini
